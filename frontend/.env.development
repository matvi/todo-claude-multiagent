VITE_API_BASE_URL=http://localhost:8080

# Entra External ID (specs §16.9.1). All four are PUBLIC identifiers, not secrets —
# never put a client secret here (the SPA is a public client using PKCE).
# Values come from the human-run tenant bootstrap (§16.11) and are empty in git because
# the tenant is created out of band. With them empty the app renders an explicit
# "sign-in is not configured" message instead of silently failing every API call.
VITE_ENTRA_TENANT_SUBDOMAIN=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_SPA_CLIENT_ID=
VITE_API_SCOPE=

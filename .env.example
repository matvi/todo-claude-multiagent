# ---------------------------------------------------------------------------
# Local development environment template. Copy to `.env` and adjust as needed.
# There are NO database passwords anywhere: the application authenticates to
# PostgreSQL with Entra / managed identity ONLY (specs §14), and the local
# Postgres container runs with `trust` auth so the same single code path works
# locally (specs §14.6).
# Production/Azure secrets are supplied at deploy time (see README.dev.md).
# ---------------------------------------------------------------------------

# --- Local Postgres (docker-compose.yml) ---
POSTGRES_USER=todo
POSTGRES_DB=tododb
POSTGRES_HOST_AUTH_METHOD=trust

# --- Backend (.NET) ---
# EF Core connection string. Matches the docker-compose Postgres above.
# Passwordless by contract: `Username=` is the Postgres role that maps to the
# caller's Entra identity (locally just the local `todo` role). No SSL locally
# (loopback hosts are exempt from the forced-TLS rule). In Azure this is
# injected as a PLAIN env var ConnectionStrings__TodoDb with
# Username=todo-api;Ssl Mode=Require — never a secret, it carries no credential.
ConnectionStrings__TodoDb=Host=localhost;Port=5432;Database=tododb;Username=todo;Ssl Mode=Disable

# --- Backend: end-user authentication (Entra External ID, specs §16.7.1) ---
# All five are PUBLIC identifiers (a URL, GUIDs, a scope name) — never credentials, so
# they are plain env vars, never Container Apps secrets and never Key Vault. The API
# fails fast at startup if any of them is missing or blank. Fill them in from the
# human-run tenant bootstrap (specs §16.11 / infra/README.md).
AzureAd__Instance=
AzureAd__TenantId=
AzureAd__ClientId=
AzureAd__Audience=
AzureAd__Scopes=Todos.ReadWrite
# Optional: exact name of the phone extension claim, e.g.
# extension_<b2cExtensionsAppIdWithoutHyphens>_phoneNumber. Left blank the API matches
# any claim whose type ends with _phoneNumber, so no tenant GUID is hard-coded.
Users__PhoneClaimName=

# --- Frontend (Vite) ---
# Base URL of the API. Baked into the bundle at build time.
VITE_API_BASE_URL=http://localhost:8080
# Identity identifiers, also baked at build time. Public, not secrets — the SPA is a
# public client using authorization code + PKCE and has no client secret.
VITE_ENTRA_TENANT_SUBDOMAIN=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_SPA_CLIENT_ID=
VITE_API_SCOPE=
